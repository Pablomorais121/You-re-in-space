<div>
    <div>
        <input type="text" name="name" value="{{item.name}}">
    </div>

    <div class="field-row">
        <label>{{localize "SPACEFUCKED.Durability"}}</label>
        <input type="number" name="system.durability.value" value="{{system.durability.value}}">
        <span>/</span>
        <input type="number" name="system.durability.max" value="{{system.durability.max}}">
    </div>

    <div class="field-row">
        <label>{{localize "SPACEFUCKED.Description"}}</label>
        <button type="button" class="edit-toggle" data-action="toggleEditor" data-field="description">
            <i class="fas fa-edit"></i>
        </button>
        {{#if (sf_has editingFields "description")}}
            <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
        {{else}}
            <div class="enriched-preview">{{{enrichedDescription}}}</div>
        {{/if}}
    </div>
</div>