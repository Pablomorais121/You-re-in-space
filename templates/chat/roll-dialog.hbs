<div class="spacefucked-roll-form">
  <div class="form-group">
    <label>{{localize "SPACEFUCKED.RollStat"}}</label>
    <div class="button-toggle-group">
      <button type="button" class="toggle-btn" data-stat="tech">{{localize "SPACEFUCKED.StatTech"}}</button>
      <button type="button" class="toggle-btn" data-stat="flesh">{{localize "SPACEFUCKED.StatFlesh"}}</button>
    </div>
    <input type="hidden" name="stat" value="none" />
  </div>

  <div class="form-group">
    <label>
      <input type="checkbox" name="desperation" />
      {{localize "SPACEFUCKED.RollDesperation"}}
    </label>
  </div>

  <div class="form-group">
    <label>{{localize "SPACEFUCKED.RollAdvantage"}}</label>
    <div class="counter-group">
      <button type="button" class="counter-btn" data-counter="advantage" data-delta="-1">−</button>
      <span class="counter-value" data-counter-value="advantage">0</span>
      <button type="button" class="counter-btn" data-counter="advantage" data-delta="1">+</button>
    </div>
    <input type="hidden" name="advantage" value="0" />
  </div>

  <div class="form-group">
    <label>{{localize "SPACEFUCKED.RollDisadvantage"}}</label>
    <div class="counter-group">
      <button type="button" class="counter-btn" data-counter="disadvantage" data-delta="-1">−</button>
      <span class="counter-value" data-counter-value="disadvantage">0</span>
      <button type="button" class="counter-btn" data-counter="disadvantage" data-delta="1">+</button>
    </div>
    <input type="hidden" name="disadvantage" value="0" />
  </div>

  <div class="pool-display">
    {{localize "SPACEFUCKED.RollPool"}}: <span class="pool-value">1</span>
  </div>
</div>