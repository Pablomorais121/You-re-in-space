<div>
    <div>
        <input type="text" name="name" value="{{actor.name}}">
    </div>
    <div class="field-row">
        <label>{{localize "SPACEFUCKED.Pronouns"}}</label>
        <input type="text" name="system.pronouns" value="{{system.pronouns}}">
    </div>

    <div class="field-row">
        <label>{{localize "SPACEFUCKED.Disposition"}}</label>
        <select name="system.disposition">
            <option value="Friendly" {{#if (eq system.disposition "Friendly")}}selected{{/if}}>{{localize "SPACEFUCKED.DispositionFriendly"}}</option>
            <option value="Neutral" {{#if (eq system.disposition "Neutral")}}selected{{/if}}>{{localize "SPACEFUCKED.DispositionNeutral"}}</option>
            <option value="Hostile" {{#if (eq system.disposition "Hostile")}}selected{{/if}}>{{localize "SPACEFUCKED.DispositionHostile"}}</option>
        </select>
    </div>
    <div class="field-row">
        <label>{{localize "SPACEFUCKED.Health"}}</label>
        <input type="number" name="system.health" value="{{system.health}}">
    </div>

    <div class="field-row">
        <label>{{localize "SPACEFUCKED.Motivation"}}</label>
        <button type="button" class="edit-toggle" data-action="toggleEditor" data-field="motivation">
            <i class="fas fa-edit"></i>
        </button>
        {{#if (sf_has editingFields "motivation")}}
            <prose-mirror name="system.motivation" value="{{system.motivation}}"></prose-mirror>
        {{else}}
            <div class="enriched-preview">{{{enrichedMotivation}}}</div>
        {{/if}}
    </div>

    <div class="field-row">
        <label>{{localize "SPACEFUCKED.Description"}}</label>
        <button type="button" class="edit-toggle" data-action="toggleEditor" data-field="description">
            <i class="fas fa-edit"></i>
        </button>
        {{#if (sf_has editingFields "description")}}
            <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
        {{else}}
            <div class="enriched-preview">{{{enrichedDescription}}}</div>
        {{/if}}
    </div>
</div>