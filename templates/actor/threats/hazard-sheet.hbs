<div>
    <div>
        <input type="text" name="name" value="{{actor.name}}">
    </div>
    <div class="field-row">
        <label>{{localize "SPACEFUCKED.TriggerCondition"}}</label>
        <button type="button" class="edit-toggle" data-action="toggleEditor" data-field="triggerCondition">
            <i class="fas fa-edit"></i>
        </button>
        {{#if (sf_has editingFields "triggerCondition")}}
            <prose-mirror name="system.triggerCondition" value="{{system.triggerCondition}}"></prose-mirror>
        {{else}}
            <div class="enriched-preview">{{{enrichedTriggerCondition}}}</div>
        {{/if}}
    </div>
    <div class="field-row">
        <label>{{localize "SPACEFUCKED.Description"}}</label>
        <button type="button" class="edit-toggle" data-action="toggleEditor" data-field="description">
            <i class="fas fa-edit"></i>
        </button>
        {{#if (sf_has editingFields "description")}}
            <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
        {{else}}
            <div class="enriched-preview">{{{enrichedDescription}}}</div>
        {{/if}}
    </div>
</div>